PARSER_BEGIN(LP1Parser)
  public class LP1Parser{}
PARSER_END(LP1Parser)

/* WHITE SPACE */

SKIP :
{
  " " | "\t" | "\n" | "\r" | "\f"
}

/* RESERVED WORDS, OPERATORS, etc  */

TOKEN : 
{
  < EQU: "==" >
| < NEQ: "!=" >
| < GEQ: ">=" >
| < LEQ: "<=" >

| < TRUE:  "true" >
| < FALSE: "false" >


/* LITERALS */

| < NUM: ( ["1"-"9"] (["0"-"9"])* | "0" ) >

/* IDENTIFIERS */

| < ID: <LETTER> (<LETTER>|<DIGIT>|<UNDER>)* >
| < #LETTER: ["A"-"Z","a"-"z"] >
| < #DIGIT: ["0"-"9"] >
| < #UNDER: "_" >
}

/**************************************************
 * The Midterm Exam #1 Example grammar            *
 **************************************************/

Absyn.Goal Goal() :
{ Absyn.Exp e; }
{
  e = Expr() <EOF>   { return new Absyn.Goal(e); }
}

Absyn.Exp Expr() :
{ Absyn.Exp left, right; }
{
   left = Term() 
	(
	  "==" right = Term()  {  left = new Absyn.EquExp(left,right); }
	| "!=" right = Term()  {  left = new Absyn.NeqExp(left,right); }
	)*
   { return left; }
}

Absyn.Exp Term() :
{ Absyn.Exp left, right; }
{
   left = Factor() 
	(
	  ">=" right = Factor()  {  left = new Absyn.GeqExp(left,right); }
	| "<=" right = Factor()  {  left = new Absyn.LeqExp(left,right); }
	)*
   { return left; }
}

Absyn.Exp Factor() :
{ Token t; }
{
   t = <NUM>   {  return new Absyn.NumExp(t.image);    }
|  "true"      {  return new Absyn.BoolLiteral(true);  }
|  "false"     {  return new Absyn.BoolLiteral(false); }
|  t = <ID>    {  return new Absyn.IdExp(t.image);     }
}
